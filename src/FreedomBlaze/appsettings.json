{
  // Detailed circuit/exception errors are surfaced to the browser; keep off by default so
  // production never leaks stack traces. The Development override turns this back on locally.
  "DetailedErrors": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BaseUrl": "https://localhost:7029/",
  "ConnectionStrings": {
    // Local dev default (SQL Server LocalDB). Override in production via the
    // ConnectionStrings__FreedomBlazeDb environment variable or Key Vault.
    "FreedomBlazeDb": "Server=(localdb)\\MSSQLLocalDB;Database=FreedomBlazeDb;Trusted_Connection=True;Encrypt=False;MultipleActiveResultSets=False"
  },
  "UseKeyVault": false,
  "KeyVaultName": "freedom-blaze-key-vault",
  "AzureADManagedIdentityClientId": "",
  "CurrencyExchangeRateApi": "",
  "ExchangeRateApiKey": "",
  "CurrencyExchange": {
    "Provider": "ExchangeRateApiCom",
    "CacheDuration": "01:00:00"
  },
  "PhoenixConfig": {
    "Token": "",
    "Host": "",
    "Username": ""
  },
  "TelegramBotFBToken": "your-telegram-bot-token",
  "TelegramFBContactChannelId": "your-telegram-chat-id",
  // Optional: dedicated channel for donation notifications. Falls back to the contact channel when empty.
  "TelegramFBDonationChannelId": "",
  "OpenAI": {
    "ApiKey": "", // Set this in Key Vault or via the OpenAI__ApiKey environment variable. Never commit a key.
    // Must support the Responses API web_search tool AND structured outputs.
    "Model": "gpt-5.6-terra",
    // Use at least low effort for web-search compatibility and quality across models.
    "ReasoningEffort": "low",
    "NewsArticleCount": 9,
    "CacheDuration": "24:00:00",
    // Back off for this long after a failed generation instead of retrying (and paying) per page view.
    "FailureCooldown": "00:10:00",
    "GenerationTimeout": "00:04:00",
    // Days older than this are served from storage only; they are never generated on demand.
    "MaxGenerationHistoryDays": 30
  },
  "MicrosoftClarity": {
    "ProjectId": "x0gqysqode"
  },
  // Public conversion API. Key management (/api/admin/api-keys) is authorized by a MASTER API key
  // sent in the X-Api-Key header; the first master key is auto-generated and logged once on startup.
  // DefaultRateLimitPerMinute applies to keys that don't set their own budget.
  "ApiKeys": {
    "DefaultRateLimitPerMinute": 60
  }
}
