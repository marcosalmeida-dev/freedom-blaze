@using FreedomBlaze.Models
@using FreedomBlaze.Services
@using FreedomBlaze.Components.Payments
@using Microsoft.Extensions.Localization

@inherits LayoutComponentBase
@implements IAsyncDisposable

<MudThemeProvider @ref="@_mudThemeProvider" @bind-IsDarkMode="@ThemeManager.IsDarkMode" Theme="_theme" />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider
    FullWidth="true"
    CloseButton="true"
    CloseOnEscapeKey="true"
    MaxWidth="MaxWidth.ExtraSmall"
    Position="DialogPosition.Center" />

<MudLayout>
    <a href="#main-content" class="skip-to-content">@Localizer["Common.SkipToContent"]</a>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" aria-label="@Localizer["Common.ToggleNavigation"]" />
        <MudImage Src="/img/freedom-blaze-logo-3-4-small.png" Class="app-icon" Alt="Freedom Blaze logo" Height="40" Width="30" />
        <MudText Typo="Typo.h5" Class="app-name ml-3">Freedom Blaze</MudText>
        <MudSpacer />

        <MudSelect T="string" @bind-Value="CultureService.LanguageCultureName"
                   Variant="Variant.Text" Margin="Margin.Dense"
                   Class="appbar-language-select" PopoverClass="language-dropdown"
                   AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                   Underline="false" aria-label="@Localizer["Common.SelectLanguage"]">
            @foreach (var language in CurrencyModel.CurrencyListStatic)
            {
                <MudSelectItem Value="@language.CultureName" @key="@language.CultureName">
                    <span class="language-option">
                        <img src="@language.FlagSvgPath" height="14" width="20" alt="" />
                        <span>@language.CultureInfo.NativeName</span>
                    </span>
                </MudSelectItem>
            }
        </MudSelect>
        @if (_btcPriceCulture != null)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.CurrencyBitcoin"
                     Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small"
                     OnClick="@(() => WriteTextAsync(_btcPriceCulture))" Class="ml-2 appbar-btc-price">
                @_btcPriceCulture
            </MudChip>
        }
        @if (PaymentsEnabled)
        {
            <MudTooltip Text="@Localizer["Common.Donate"]">
                <MudIconButton Icon="@Icons.Material.Filled.Bolt" Color="Color.Inherit"
                               OnClick="OpenDonateDialogAsync" aria-label="@Localizer["Common.Donate"]" Class="ml-1" />
            </MudTooltip>
        }
        <MudIconButton Icon="@(ThemeManager.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ThemeManager.ToggleTheme"
                       aria-label="@Localizer["Common.ToggleDarkMode"]" Class="ml-1 toggle-switch" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Temporary">
        <NavMenu />
    </MudDrawer>
    <MudMainContent id="main-content">
        <MudContainer Class="main-content-container">
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <MudAlert Severity="Severity.Error" Class="ma-4">
                        An unexpected error occurred. Please refresh the page.
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IHttpContextAccessor ContextAccessor
@inject CultureService CultureService
@inject ISnackbar Snackbar
@inject AppState AppState
@inject ThemeManager ThemeManager
@inject IDialogService DialogService
@inject IStringLocalizer<Resources.Localization> Localizer

@code {
    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#f7931a",
            Secondary = Colors.BlueGray.Darken1,
            AppbarBackground = "#1a1a2e",
            Background = "#f8fafd",
            Surface = Colors.Shades.White,
            DrawerBackground = "#1a1a2e",
            DrawerText = Colors.Shades.White,
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#f7931a",
            Secondary = Colors.Green.Lighten1,
            AppbarBackground = "#0d0d0f",
            Background = "#13131a",
            Surface = "#1e1e2a",
            DrawerBackground = "#0d0d0f",
        }
    };

    private MudThemeProvider _mudThemeProvider = null!;

    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private int? _themeWatcherId;

    private string _darkModeCookieName = "darkModeCookie";

    private bool _drawerOpen = false;
    private bool _disposed;

    private string? _btcPriceCulture;

    private EventHandler _cultureChangedHandler = default!;

    CancellationTokenSource cancellationTokenSource = new CancellationTokenSource();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _cultureChangedHandler = (_, _) => OnLanguageChanged();
                CultureService.OnLanguageChanged += _cultureChangedHandler;
                AppState.OnChange += OnAppStateChanged;
                ThemeManager.OnThemeChanged += ThemeChanged;

                _dotNetRef = DotNetObjectReference.Create(this);
                _themeWatcherId = await JS.InvokeAsync<int>("darkModeHelper.watchSystemPreference", cancellationTokenSource.Token, _dotNetRef);
                var savedDarkMode = await JS.InvokeAsync<string>("cookieHelper.getCookie", cancellationTokenSource.Token, _darkModeCookieName);
                if (bool.TryParse(savedDarkMode, out var isDarkMode))
                {
                    ThemeManager.IsDarkMode = isDarkMode;
                }
                else
                {
                    ThemeManager.IsDarkMode = await JS.InvokeAsync<bool>("darkModeHelper.getSystemPreference", cancellationTokenSource.Token);
                }

                await InvokeAsync(StateHasChanged);
                await AppState.EnsureRatesAsync(cancellationTokenSource.Token);
                await OnAppStateChanged();
            }
            catch (JSDisconnectedException) { }
            catch (OperationCanceledException) { }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public Task SystemPreferenceChanged(bool isDark)
    {
        ThemeManager.IsDarkMode = isDark;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ThemeChanged(bool isDarkMode)
    {
        try
        {
            await JS.InvokeVoidAsync("cookieHelper.setCookie", cancellationTokenSource.Token, _darkModeCookieName, isDarkMode.ToString(), 365);
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
    }

    private Task OnAppStateChanged() => InvokeAsync(() =>
    {
        if (_disposed)
            return;

        var rates = AppState.BitcoinExchangeRate;
        if (rates is null || rates.BitcoinRateInUSD <= 0)
            return;

        _btcPriceCulture = $"{rates.BitcoinRateInUSD.ToString("N2", CultureService.CurrentCulture)} USD";
        StateHasChanged();
    });

    private void OnLanguageChanged()
    {
        // A previous language in the URL must not override the newly saved cookie.
        // Keep other query values escaped and retain the current anchor.
        var destination = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["culture"] = null,
            ["ui-culture"] = null
        }));
        var uriEscaped = Uri.EscapeDataString(destination.PathAndQuery + destination.Fragment);

        Navigation.NavigateTo(
            $"Culture/Set?culture={CultureService.LanguageCultureName}&redirectUri={uriEscaped}",
            forceLoad: true);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    // The donate feature is only available when a phoenixd node is configured.
    private bool PaymentsEnabled => !string.IsNullOrWhiteSpace(Configuration["PhoenixConfig:Host"]);

    private Task OpenDonateDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            Position = DialogPosition.Center
        };

        return DialogService.ShowAsync<DonateDialog>("Donate", options);
    }

    private void SnackMessage(string message, string position = Defaults.Classes.Position.TopCenter, Severity severity = Severity.Info)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Text;
        Snackbar.Configuration.PositionClass = position;
        Snackbar.Add(message, severity);
    }

    private async Task WriteTextAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            SnackMessage($"{text} Copied to clipboard!", position: Defaults.Classes.Position.TopRight, severity: Severity.Success);
        }
        catch (Exception ex)
        {
            SnackMessage($"Error copying to clipboard: {ex.Message}", severity: Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        CultureService.OnLanguageChanged -= _cultureChangedHandler;
        AppState.OnChange -= OnAppStateChanged;
        ThemeManager.OnThemeChanged -= ThemeChanged;

        await cancellationTokenSource.CancelAsync();
        try
        {
            if (_themeWatcherId is { } watcherId)
                await JS.InvokeVoidAsync("darkModeHelper.unwatchSystemPreference", watcherId);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        finally
        {
            _dotNetRef?.Dispose();
            cancellationTokenSource.Dispose();
        }
    }
}
