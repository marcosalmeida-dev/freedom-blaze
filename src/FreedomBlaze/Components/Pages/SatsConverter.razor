@page "/satsconverter"
@rendermode InteractiveServer
@using System.Globalization
@using FreedomBlaze.Models

<PageSeo Title="@Localizer["SatsConverter.SeoTitle"]"
         Description="@Localizer["SatsConverter.SeoDescription"]"
         RelativePath="satsconverter" />

<div class="sats-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">@Localizer["SatsConverter.Eyebrow"]</p>
            <h1>@Localizer["SatsConverter.Title"]</h1>
            <p class="page-description">@Localizer["SatsConverter.Description"]</p>
        </div>
        <span class="rate-status" role="status">
            <span class="status-dot @(_state.HasRates && !AppState.HasRateError ? "available" : "")" aria-hidden="true"></span>
            @Localizer[_loading ? "SatsConverter.UpdatingRates" : AppState.HasRateError ? "SatsConverter.RatesDelayed" : _state.HasRates ? "SatsConverter.LiveRates" : "SatsConverter.WaitingForRates"]
        </span>
    </header>

    @if (_error is not null)
    {
        <div class="rate-error" role="alert">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
            <span>@_error</span>
            <button type="button" class="text-action" disabled="@_loading" @onclick="RefreshRatesAsync">@Localizer["SatsConverter.Retry"]</button>
        </div>
    }

    <div class="converter-layout">
        <section class="converter-card" aria-labelledby="converter-heading" aria-busy="@_initializing.ToString().ToLowerInvariant()">
            <div class="card-heading">
                <h2 id="converter-heading">@Localizer["SatsConverter.ConvertHeading"]</h2>
                <MudIcon Icon="@Icons.Material.Filled.CurrencyBitcoin" Color="Color.Primary" />
            </div>
            <p class="field-hint">@Localizer["SatsConverter.EnterAmount"]</p>

            <div class="currency-select">
                <MudSelect T="string" Value="_state.SelectedCurrency.CultureName" ValueChanged="SelectCurrencyAsync"
                           InputId="converter-currency" Label="@Localizer["SatsConverter.YourCurrency"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_initializing"
                           aria-label="@Localizer["Common.SelectCurrency"]"
                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" MaxHeight="320">
                    @foreach (var currency in CurrencyModel.CurrencyListStatic)
                    {
                        <MudSelectItem T="string" Value="@currency.CultureName" @key="currency.CultureName">
                            <span class="currency-option">
                                <img src="@currency.FlagSvgPath" width="28" height="20" alt="" />
                                <span>@currency.Value — @Localizer[$"Currency.{currency.Value}"]</span>
                            </span>
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="conversion-fields">
                @if (_satsFieldOnTop)
                {
                    @SatsField
                }
                else
                {
                    @CurrencyField
                }

                <div class="swap-row">
                    <span aria-hidden="true"></span>
                    <button type="button" class="swap-button" @onclick="SwapFields" aria-label="@Localizer["SatsConverter.SwapFields"]">
                        <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                    </button>
                    <span aria-hidden="true"></span>
                </div>

                @if (_satsFieldOnTop)
                {
                    @CurrencyField
                }
                else
                {
                    @SatsField
                }
            </div>

            @if (_state.InputOutOfRange)
            {
                <p class="input-error" role="alert">@Localizer["SatsConverter.AmountTooLarge"]</p>
            }
            <div class="bitcoin-equivalent">
                <span>@Localizer["SatsConverter.BitcoinEquivalent"]</span>
                <output aria-live="polite" aria-atomic="true">@(_state.BitcoinAmount?.ToString("N8", DisplayCulture) ?? "—") <small>BTC</small></output>
            </div>
            <p class="conversion-note">@Localizer["SatsConverter.ConversionNote", 100_000_000m.ToString("N0", DisplayCulture)]</p>
            <aside class="conversion-reference" aria-labelledby="conversion-reference-heading">
                <h3 id="conversion-reference-heading">@Localizer["SatsConverter.QuickReference"]</h3>
                <dl>
                    @foreach (var sats in ReferenceSatsAmounts)
                    {
                        <div>
                            <dt>@Localizer["SatsConverter.ReferenceSats", sats.ToString("N0", DisplayCulture)]</dt>
                            <dd>@FormatReferenceAmount(sats)</dd>
                        </div>
                    }
                </dl>
                <p>@Localizer["SatsConverter.RateExplanation"]</p>
            </aside>
        </section>

        <section class="rates-card" aria-labelledby="rates-heading" aria-busy="@_loading.ToString().ToLowerInvariant()">
            <div class="rates-heading">
                <div>
                    <h2 id="rates-heading">@Localizer["SatsConverter.AcrossCurrencies"]</h2>
                    <p>@Localizer["SatsConverter.CompareHint"]</p>
                </div>
                <button type="button" class="refresh-button" disabled="@_loading" @onclick="RefreshRatesAsync" aria-label="@Localizer["SatsConverter.RefreshRates"]" title="@Localizer["SatsConverter.RefreshRates"]">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" />
                </button>
            </div>

            <table class="rates-table">
                <caption class="visually-hidden">@Localizer["SatsConverter.TableCaption"]</caption>
                <thead>
                    <tr><th scope="col">@Localizer["SatsConverter.Currency"]</th><th scope="col">@Localizer["SatsConverter.OneBitcoin"]</th><th scope="col">@Localizer["SatsConverter.YourAmount"]</th><th scope="col" class="usd-rate">@Localizer["SatsConverter.OneUsd"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var currency in _state.Currencies)
                    {
                        var selected = currency == _state.SelectedCurrency;
                        var hasAmount = _state.HasRates && !_state.InputOutOfRange && _state.BitcoinAmount.HasValue && currency.BitcoinPrice > 0;
                        <tr @key="currency.Value" class="@(selected ? "selected-currency" : null)">
                            <th scope="row">
                                <button type="button" class="currency-button" aria-pressed="@selected.ToString().ToLowerInvariant()"
                                        aria-label="@Localizer["SatsConverter.UseCurrency", Localizer[$"Currency.{currency.Value}"]]" disabled="@_initializing" @onclick="() => SelectCurrencyAsync(currency.CultureName)">
                                    <img src="@currency.FlagSvgPath" width="28" height="20" alt="" loading="lazy" />
                                    <span><strong>@currency.Value</strong><small>@Localizer[$"Currency.{currency.Value}"]</small></span>
                                    @if (selected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="selected-icon" />
                                    }
                                </button>
                            </th>
                            <td data-label="@Localizer["SatsConverter.OneBitcoin"]">
                                <button type="button" class="value-button" disabled="@(currency.BitcoinPrice <= 0)"
                                        aria-label="@Localizer["SatsConverter.CopyBitcoinPrice", currency.Value]" @onclick="() => CopyAsync(currency.BitcoinPrice)">
                                    @(currency.BitcoinPrice > 0 ? currency.BitcoinPrice.ToString("C", currency.CultureInfo) : "—")
                                </button>
                            </td>
                            <td data-label="@Localizer["SatsConverter.YourAmount"]" class="converted-value">
                                <button type="button" class="value-button" disabled="@(!hasAmount)"
                                        aria-label="@Localizer["SatsConverter.CopyConvertedAmount", currency.Value]" @onclick="() => CopyAsync(currency.CurrencyValueInCurrency)">
                                    @(hasAmount ? currency.CurrencyValueInCurrency.ToString("C", currency.CultureInfo) : "—")
                                </button>
                            </td>
                            <td class="usd-rate">@(currency.CurrencyRateInUSD > 0 ? currency.CurrencyRateInUSD.ToString("C", currency.CultureInfo) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="rates-footer" role="status">
                @if (_lastUpdateFormatted is not null)
                {
                    <span>@Localizer["SatsConverter.Updated"] <time datetime="@AppState.LastUpdate.ToString("O")">@_lastUpdateFormatted</time></span>
                }
                else
                {
                    <span>@Localizer[_loading ? "SatsConverter.GettingRates" : "SatsConverter.RatesUnavailable"]</span>
                }
                <span>@Localizer["SatsConverter.UpdatesEveryMinute"]</span>
            </div>
        </section>
    </div>

    <div class="converter-details">
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            <MudExpansionPanel Text="@Localizer["SatsConverter.Denominations"]" Icon="@Icons.Material.Outlined.Info">
                <SatsInfo />
            </MudExpansionPanel>
            <MudExpansionPanel Text="@Localizer["SatsConverter.ExchangeStatus"]" Icon="@Icons.Material.Filled.BarChart">
                <BitcoinExchangeStatusList ExchangeStatusList="AppState.ExchangeStatusList" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</div>

@code {
    private RenderFragment CurrencyField => @<div class="amount-field">
        <MudNumericField T="decimal?" Value="_state.CurrencyAmount" ValueChanged="SetCurrencyAmountAsync"
                         Label="@Localizer["SatsConverter.AmountInCurrency", _state.SelectedCurrency.Value]" Culture="DisplayCulture" Format="N2"
                         Min="0m" Max="SatsConversionState.MaximumAmount" HideSpinButtons="true" Variant="Variant.Outlined"
                         InputMode="@(InputMode.@decimal)" Immediate="true" DebounceInterval="200" Disabled="@_initializing" />
        <button type="button" class="copy-button" disabled="@(!_state.CurrencyAmount.HasValue)"
                @onclick="() => CopyAsync(_state.CurrencyAmount)" aria-label="@Localizer["SatsConverter.CopyCurrencyAmount"]" title="@Localizer["SatsConverter.CopyCurrencyAmount"]">
            <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
        </button>
    </div>;

    private RenderFragment SatsField => @<div class="amount-field">
        <MudNumericField T="decimal?" Value="_state.SatsAmount" ValueChanged="SetSatsAmountAsync"
                         Label="@Localizer["SatsConverter.Satoshis"]" Culture="DisplayCulture" Format="N0"
                         Min="0m" Max="SatsConversionState.MaximumAmount" Step="1m" HideSpinButtons="true" Variant="Variant.Outlined"
                         InputMode="InputMode.numeric" Immediate="true" DebounceInterval="200" Disabled="@_initializing" />
        <button type="button" class="copy-button" disabled="@(!_state.SatsAmount.HasValue)"
                @onclick="() => CopyAsync(_state.SatsAmount)" aria-label="@Localizer["SatsConverter.CopySats"]" title="@Localizer["SatsConverter.CopySats"]">
            <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" />
        </button>
    </div>;
}
