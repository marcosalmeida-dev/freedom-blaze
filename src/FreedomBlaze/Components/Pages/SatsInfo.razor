@using Microsoft.Extensions.Localization
@using System.Globalization

@inject IStringLocalizer<Resources.Localization> Localizer

<div class="pa-2">
    <MudText Typo="Typo.subtitle1" Class="mb-2">@Localizer["SatsInfo.Title"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">@Localizer["SatsInfo.Body1"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@Localizer["SatsInfo.Body2"]</MudText>

    <MudSimpleTable Dense="true" Style="overflow-x: auto;">
        <thead>
            <tr>
                <th scope="col">@Localizer["SatsInfo.Sats"]</th>
                <th scope="col">@Localizer["SatsInfo.Bitcoin"]</th>
                <th scope="col">@Localizer["SatsInfo.Name"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sats in Denominations)
            {
                <tr>
                    <td>@sats.ToString("N0", CultureInfo.CurrentCulture) sats</td>
                    <td>@((sats / 100_000_000m).ToString("N8", CultureInfo.CurrentCulture)) BTC</td>
                    <td>@GetDenominationName(sats)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudText Typo="Typo.subtitle1" Class="mt-6 mb-3 d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.QuestionAnswer" Class="mr-2" Color="Color.Primary" />
        @Localizer["SatsInfo.FaqTitle"]
    </MudText>

    <section aria-label="@Localizer["SatsInfo.FaqLabel"]">
        @foreach (var faq in _faqs)
        {
            <div class="mb-3">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@faq.Question</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@faq.Answer</MudText>
            </div>
        }
    </section>
</div>

@* Keep the structured data in the same language as the visible answers. *@
@_faqStructuredData

@code {
    private sealed record Faq(string Question, string Answer);

    private static readonly int[] Denominations = [1, 10, 100, 1_000, 10_000, 100_000, 1_000_000, 10_000_000, 100_000_000];
    private Faq[] _faqs = [];
    private MarkupString _faqStructuredData;
    private string? _contentCultureName;

    protected override void OnParametersSet()
    {
        var cultureName = CultureInfo.CurrentUICulture.Name;
        if (_contentCultureName == cultureName)
            return;

        _contentCultureName = cultureName;
        _faqs = Enumerable.Range(1, 5)
            .Select(index => new Faq(Localizer[$"SatsInfo.Faq{index}Question"], Localizer[$"SatsInfo.Faq{index}Answer"]))
            .ToArray();
        _faqStructuredData = (MarkupString)BuildFaqJsonLd();
    }

    private string GetDenominationName(int sats) => sats switch
    {
        1 => Localizer["SatsInfo.OneSatoshi"],
        100 => Localizer["SatsInfo.OneBit"],
        100_000 => "1 mBTC",
        1_000_000 => "1 cBTC",
        100_000_000 => Localizer["SatsInfo.OneBitcoin"],
        _ => "—"
    };

    private string BuildFaqJsonLd()
    {
        var payload = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = _faqs.Select(f => new Dictionary<string, object?>
            {
                ["@type"] = "Question",
                ["name"] = f.Question,
                ["acceptedAnswer"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Answer",
                    ["text"] = f.Answer
                }
            }).ToArray()
        };

        var json = System.Text.Json.JsonSerializer.Serialize(payload);
        return $"<script type=\"application/ld+json\">{json}</script>";
    }
}
