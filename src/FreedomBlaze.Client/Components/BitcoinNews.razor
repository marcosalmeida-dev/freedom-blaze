@page "/bitcoinnews"
@rendermode InteractiveAuto

<PageSeo Title="Bitcoin News — Daily Headlines from Around the World | Freedom Blaze"
         Description="Stay current with daily Bitcoin news headlines from around the world, refreshed every day and browsable by date."
         RelativePath="bitcoinnews" OgType="article" />

<div class="news-page">
    <header class="news-header">
        <div class="news-heading">
            <p class="news-eyebrow">Around the world</p>
            <h1>Bitcoin News</h1>
            <p class="news-date-label">@DayLabel</p>
        </div>

        <div class="news-date-filter">
            <div class="news-date-controls" role="group" aria-label="Choose a news date">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Class="news-day-button"
                               aria-label="Show an earlier day" title="Earlier day"
                               Disabled="PreviousDay is null" OnClick="@(() => GoToAsync(PreviousDay))" />

                <div class="news-date-picker">
                    <MudDatePicker Date="_selectedDate" DateChanged="OnDateChangedAsync"
                                   MinDate="MinSelectableDate" MaxDate="MaxSelectableDate" IsDateDisabledFunc="IsDateDisabled"
                                   PickerVariant="PickerVariant.Dialog" AutoClose="true"
                                   Label="News date" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   DateFormat="MMM d, yyyy" Editable="false" />
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Class="news-day-button"
                               aria-label="Show a later day" title="Later day"
                               Disabled="NextDay is null" OnClick="@(() => GoToAsync(NextDay))" />

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="news-today-button"
                           Disabled="IsToday" OnClick="@(() => GoToAsync(TodayDate))">
                    Today
                </MudButton>
            </div>
            <p class="news-filter-hint">Browse saved headlines from the last 30 days.</p>
        </div>
    </header>

    <div class="news-results-heading">
        <h2>Daily headlines</h2>
        <span role="status" aria-live="polite">@ResultsLabel</span>
    </div>

    <section aria-label="Bitcoin news headlines" aria-busy="@(_loading ? "true" : "false")">
        @if (_loading)
        {
            <div class="news-grid news-skeletons" aria-hidden="true">
                @for (var i = 0; i < SkeletonCount; i++)
                {
                    <div class="news-skeleton">
                        <div class="news-skeleton-media">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100%" />
                        </div>
                        <div class="news-skeleton-content">
                            <MudSkeleton Width="40%" Class="mb-2" />
                            <MudSkeleton Width="95%" />
                            <MudSkeleton Width="80%" Class="mt-1" />
                            <MudSkeleton Width="60%" Class="mt-1" />
                        </div>
                    </div>
                }
            </div>
        }
        else if (_errorMessage is not null)
        {
            <div class="news-empty-state" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Color="Color.Warning" />
                <h3>Couldn't load the news</h3>
                <p>@_errorMessage</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="news-state-action"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="RetryAsync">
                    Try again
                </MudButton>
            </div>
        }
        else if (_articles.Count > 0)
        {
            <div class="news-grid">
                @for (var index = 0; index < _articles.Count; index++)
                {
                    var article = _articles[index];
                    <NewsArticleCard Article="article" PrioritizeImage="@(index == 0)" @key="article" />
                }
            </div>

            <p class="news-disclosure">
                Headlines are gathered daily by an AI web search. Summaries are automated; read the
                publisher's original article for the full story.
            </p>
        }
        else
        {
            <div class="news-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Newspaper" Size="Size.Large" Color="Color.Secondary" />
                <h3>No Bitcoin news for @SelectedDate.ToString("MMMM d, yyyy")</h3>
                <p>
                    @(IsToday
                        ? "Today's headlines haven't been gathered yet. Try again in a little while."
                        : "Pick another day, or jump back to today's headlines.")
                </p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="news-state-action"
                           StartIcon="@(IsToday ? Icons.Material.Filled.Refresh : Icons.Material.Filled.Today)"
                           OnClick="OnEmptyStateActionAsync">
                    @(IsToday ? "Try again" : "Go to today")
                </MudButton>
            </div>
        }
    </section>
</div>
